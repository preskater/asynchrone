# The employees domain app (employees.copilot.asynchrone.space).
#
# It has no credential form: it signs in through Copilot with @workspace/oidc.
# Next loads this file from the app directory (`next dev` and `next start`).
# Copy it to `apps/employees/.env` and fill in the client credentials.

# This app's own public origin. Must match the registered redirect URI
# (`$EMPLOYEES_APP_URL/api/auth/callback`) and the post-logout URI.
EMPLOYEES_APP_URL="http://localhost:3009"
# Copilot's origin: the OIDC issuer and the identity/OAuth server.
COPILOT_APP_URL="http://localhost:3003"

# Confidential client credentials from
# `npm run oauth:clients --workspace=copilot -- --apply --write-env apps/copilot/.env.oauth`
# (copy the EMPLOYEES_* lines here).
EMPLOYEES_OAUTH_CLIENT_ID=""
EMPLOYEES_OAUTH_CLIENT_SECRET=""

# This app owns `asynchrone_employees`. Projects and payroll clients come from their owning apps' internal APIs.
# The per-app pool is clamped to the fleet budget (ADR 0038).
EMPLOYEES_DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone_employees?schema=public"
DATABASE_POOL_MAX="4"

# Audit rows store the client address from a proxy-overwritten header.
# Leave empty to store no IP address.
TRUSTED_IP_HEADERS=""

# Observability (issue #170). Sentry stays disabled while the DSN is empty.
# `createNextConfig` inlines the DSN into the browser bundle at build time, so
# the Docker build also needs it as the SENTRY_DSN build arg.
SENTRY_DSN=""
# Environment label and release used by Sentry and the structured request
# logs. The Helm chart sets DEPLOY_ENV=production and GIT_COMMIT_SHA=<tag>.
DEPLOY_ENV=""
GIT_COMMIT_SHA=""
