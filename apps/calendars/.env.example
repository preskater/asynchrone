# The calendars domain app (calendars.copilot.asynchrone.space).
#
# It has no credential form: it signs in through Copilot with @workspace/oidc.
# Next loads this file from the app directory (`next dev` and `next start`).
# Copy it to `apps/calendars/.env` and fill in the client credentials.

# This app's own public origin. Must match the registered redirect URI
# (`$CALENDARS_APP_URL/api/auth/callback`) and the post-logout URI.
CALENDARS_APP_URL="http://localhost:3005"
# Copilot's origin: the OIDC issuer and the identity/OAuth server.
COPILOT_APP_URL="http://localhost:3003"

# Confidential client credentials from
# `npm run oauth:clients --workspace=copilot -- --apply --write-env apps/copilot/.env.oauth`
# (copy the CALENDARS_* lines here).
CALENDARS_OAUTH_CLIENT_ID=""
CALENDARS_OAUTH_CLIENT_SECRET=""

# The database client. Until #190 the calendars domain still reads identity
# tables (member, user, session, organization) and the project task overlay, so
# the app binds the shared client (@workspace/db) and needs the same DATABASE_URL
# as Copilot. CALENDARS_DATABASE_URL becomes its own database when the domain
# moves behind the identity internal API; the schema and migration already carry
# calendarEvent, meetingRequest, oidcSession and auditLog.
DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone?schema=public"
CALENDARS_DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone_calendars?schema=public"
DATABASE_POOL_MAX="3"

# Audit rows store the client address from a proxy-overwritten header.
# Leave empty to store no IP address.
TRUSTED_IP_HEADERS=""
