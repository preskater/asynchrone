# The control tower owns its own database (ADR 0032): platform auth, 2FA,
# platform audit and handoff rows. It never points at the customer database and
# never queries another app's schema.
CONTROL_TOWER_DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone_control_tower?schema=public"
# Required by `npm run cutover:control-tower` as the copy *source* (the
# monolith snapshot that still holds the platform tables). The app itself never
# reads it.
# CONTROL_TOWER_SOURCE_DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone?schema=public"
DATABASE_POOL_MAX="3"

# Public origin of this app (not the customer app).
BETTER_AUTH_URL="http://localhost:3001"

# Deliberately different from the Copilot app's BETTER_AUTH_SECRET. The control
# tower does not register the jwt/mcp plugins, so it never needs to decrypt the
# shared JWKS rows. Use at least 32 characters.
CONTROL_TOWER_BETTER_AUTH_SECRET=""

# Origin of the customer app. Used for impersonation handoff links,
# "open in app" links and the identity admin API. This app never reads or sets
# cookies on that origin.
PLATFORM_APP_URL="http://localhost:3000"

# Confidential OAuth client provisioned by the customer app:
# `npm run oauth:clients --workspace=copilot`. Used to request an
# `internal:identity:admin` service token for the admin API.
CONTROL_TOWER_OAUTH_CLIENT_ID=""
CONTROL_TOWER_OAUTH_CLIENT_SECRET=""

# Optional comma-separated network allowlist (IPv4, IPv4 CIDR or `*`). Empty
# allows every address; the in-app auth still applies. Set this in production
# as defense in depth, ideally behind an access proxy too.
PLATFORM_ALLOWED_IPS=""

# Shown on the ops page. The Helm chart sets DEPLOY_ENV=production and
# GIT_COMMIT_SHA to the deployed image tag; locally NODE_ENV is used.
DEPLOY_ENV=""
GIT_COMMIT_SHA=""
