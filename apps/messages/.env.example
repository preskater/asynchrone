# The messages domain app (messages.copilot.asynchrone.space).
#
# It has no credential form: it signs in through Copilot with @workspace/oidc.
# Next loads this file from the app directory (`next dev` and `next start`).
# Copy it to `apps/messages/.env` and fill in the client credentials.

# This app's own public origin. Must match the registered redirect URI
# (`$MESSAGES_APP_URL/api/auth/callback`) and the post-logout URI.
MESSAGES_APP_URL="http://localhost:3007"
# Copilot's origin: the OIDC issuer and the identity/OAuth server.
COPILOT_APP_URL="http://localhost:3003"

# Confidential client credentials from
# `npm run oauth:clients --workspace=copilot -- --apply --write-env apps/copilot/.env.oauth`
# (copy the MESSAGES_* lines here).
MESSAGES_OAUTH_CLIENT_ID=""
MESSAGES_OAUTH_CLIENT_SECRET=""

# The database client. Until #190/#171 the messaging domain still reads
# `member`/`user` and attachments still use the files upload sessions and
# large objects, so this app binds the shared client (@workspace/db) and needs
# the same DATABASE_URL as Copilot. It never opens asynchrone_messages yet;
# MESSAGES_DATABASE_URL becomes its own database when the domain moves behind
# the identity/files internal APIs.
DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone?schema=public"
MESSAGES_DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone_messages?schema=public"
DATABASE_POOL_MAX="3"

# Audit rows store the client address from a proxy-overwritten header.
# Leave empty to store no IP address.
TRUSTED_IP_HEADERS=""
