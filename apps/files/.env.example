# The files domain app (files.copilot.asynchrone.space).
#
# It has no credential form: it signs in through Copilot with @workspace/oidc.
# Next loads this file from the app directory (`next dev` and `next start`).
# Copy it to `apps/files/.env` and fill in the client credentials.

# This app's own public origin. Must match the registered redirect URI
# (`$FILES_APP_URL/api/auth/callback`) and the post-logout URI.
FILES_APP_URL="http://localhost:3006"
# Copilot's origin: the OIDC issuer and the identity/OAuth server.
COPILOT_APP_URL="http://localhost:3003"

# Confidential client credentials from
# `npm run oauth:clients --workspace=copilot -- --apply --write-env apps/copilot/.env.oauth`
# (copy the FILES_* lines here).
FILES_OAUTH_CLIENT_ID=""
FILES_OAUTH_CLIENT_SECRET=""

# The database client. Until #190 the files domain still reads identity tables
# (member, user, session, organization, rateLimit) and the messaging attachments
# that reference the same large objects, so the app binds the shared client
# (@workspace/db) and needs the same DATABASE_URL as Copilot. FILES_DATABASE_URL
# becomes its own database when the domain moves behind the identity internal
# API; the schema and migration already carry fileNode, uploadSession,
# oidcSession and auditLog.
DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone?schema=public"
FILES_DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone_files?schema=public"
DATABASE_POOL_MAX="3"

# The `uploads-sweep` cron passes `Authorization: Bearer $CRON_SECRET`. Leave it
# empty in local development and guard the job only in the deployment.
CRON_SECRET=""

# Audit rows store the client address from a proxy-overwritten header.
# Leave empty to store no IP address.
TRUSTED_IP_HEADERS=""

# Observability (issue #170). Sentry stays disabled while the DSN is empty.
# `createNextConfig` inlines the DSN into the browser bundle at build time, so
# the Docker build also needs it as the SENTRY_DSN build arg.
SENTRY_DSN=""
# Environment label and release used by Sentry and the structured request
# logs. The Helm chart sets DEPLOY_ENV=production and GIT_COMMIT_SHA=<tag>.
DEPLOY_ENV=""
GIT_COMMIT_SHA=""
