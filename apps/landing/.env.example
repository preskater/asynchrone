# Public Copilot origin used by the landing's sign-in and "Open workspace"
# links. It is inlined into the bundle at build time. When unset, a production
# build uses https://copilot.asynchrone.space and `next dev` uses
# http://localhost:3003.
NEXT_PUBLIC_WORKSPACE_URL="http://localhost:3003"

# Public origin of the marketing site, used for canonical URLs, `robots.txt`
# and `sitemap.xml`. It is inlined at build time. When unset, a production
# build uses https://asynchrone.space and `next dev` uses http://localhost:3002.
NEXT_PUBLIC_SITE_URL="http://localhost:3002"
