# Dependencies (installed inside the image). The nested patterns matter: a bare
# `node_modules` only matches the context root, and every workspace has its own.
node_modules
**/node_modules
.pnp
.pnp.*

# Build output (generated during the image build)
.next
**/.next
out
**/out
dist
**/dist
build
**/build

# Turbo
.turbo
**/.turbo

# Testing
coverage
**/coverage
test-results
**/test-results
playwright-report
**/playwright-report
blob-report
**/blob-report

# Environment files (any depth, so local secrets never enter the image)
.env
.env*
**/.env
**/.env.*

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Git
.git
.gitignore
.gitattributes

# Docker files
Dockerfile*
.dockerignore
docker-compose*
compose*.yaml

# IDE / editors
.vscode
.idea
.cursor
*.swp
*.swo
*~

# TypeScript
*.tsbuildinfo

# OS files
.DS_Store
