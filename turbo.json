{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "cache": false,
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts",
        "package.json"
      ],
      "outputs": [
        "lib/generated/**"
      ],
      "env": [
        "DATABASE_URL",
        "IDENTITY_DATABASE_URL",
        "PROJECTS_DATABASE_URL",
        "CALENDARS_DATABASE_URL",
        "FILES_DATABASE_URL",
        "MESSAGES_DATABASE_URL",
        "CLIENTS_DATABASE_URL",
        "EMPLOYEES_DATABASE_URL",
        "CONTROL_TOWER_DATABASE_URL"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "IDENTITY_DATABASE_URL",
        "PROJECTS_DATABASE_URL",
        "CALENDARS_DATABASE_URL",
        "FILES_DATABASE_URL",
        "MESSAGES_DATABASE_URL",
        "CLIENTS_DATABASE_URL",
        "EMPLOYEES_DATABASE_URL",
        "CONTROL_TOWER_DATABASE_URL",
        "COPILOT_OAUTH_CLIENT_ID",
        "COPILOT_OAUTH_CLIENT_SECRET",
        "PROJECTS_OAUTH_CLIENT_ID",
        "PROJECTS_OAUTH_CLIENT_SECRET",
        "CALENDARS_OAUTH_CLIENT_ID",
        "CALENDARS_OAUTH_CLIENT_SECRET",
        "FILES_OAUTH_CLIENT_ID",
        "FILES_OAUTH_CLIENT_SECRET",
        "MESSAGES_OAUTH_CLIENT_ID",
        "MESSAGES_OAUTH_CLIENT_SECRET",
        "CLIENTS_OAUTH_CLIENT_ID",
        "CLIENTS_OAUTH_CLIENT_SECRET",
        "EMPLOYEES_OAUTH_CLIENT_ID",
        "EMPLOYEES_OAUTH_CLIENT_SECRET",
        "CONTROL_TOWER_OAUTH_CLIENT_ID",
        "CONTROL_TOWER_OAUTH_CLIENT_SECRET",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "LANDING_APP_URL",
        "COPILOT_APP_URL",
        "PROJECTS_APP_URL",
        "CALENDARS_APP_URL",
        "FILES_APP_URL",
        "MESSAGES_APP_URL",
        "CLIENTS_APP_URL",
        "EMPLOYEES_APP_URL",
        "CONTROL_TOWER_APP_URL",
        "OAUTH_TRUSTED_CLIENT_IDS",
        "OPENAI_API_KEY",
        "OPENAI_API_URL",
        "ASSISTANT_MODEL",
        "MCP_RESOURCE_URL",
        "CRON_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITLAB_CLIENT_ID",
        "GITLAB_CLIENT_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "FEEDBACK_EMAIL_TO",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_WORKSPACE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "REQUIRE_EMAIL_VERIFICATION",
        "TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "SIGNUP_INVITE_ONLY",
        "SIGNUP_BLOCKED_EMAIL_DOMAINS",
        "TRUSTED_IP_HEADERS",
        "CONTROL_TOWER_BETTER_AUTH_SECRET",
        "PLATFORM_APP_URL",
        "CONTROL_TOWER_URL",
        "PLATFORM_ALLOWED_IPS",
        "DEPLOY_ENV",
        "GIT_COMMIT_SHA",
        "SENTRY_DSN",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_PRICE_TEAM_MONTHLY",
        "STRIPE_PRICE_TEAM_YEARLY",
        "STRIPE_AUTOMATIC_TAX"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "generate"
      ]
    },
    "test:contracts": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CONTROL_TOWER_URL",
        "IDENTITY_DATABASE_URL"
      ]
    },
    "dev": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "IDENTITY_DATABASE_URL",
        "PROJECTS_DATABASE_URL",
        "CALENDARS_DATABASE_URL",
        "FILES_DATABASE_URL",
        "MESSAGES_DATABASE_URL",
        "CLIENTS_DATABASE_URL",
        "EMPLOYEES_DATABASE_URL",
        "CONTROL_TOWER_DATABASE_URL",
        "COPILOT_OAUTH_CLIENT_ID",
        "COPILOT_OAUTH_CLIENT_SECRET",
        "PROJECTS_OAUTH_CLIENT_ID",
        "PROJECTS_OAUTH_CLIENT_SECRET",
        "CALENDARS_OAUTH_CLIENT_ID",
        "CALENDARS_OAUTH_CLIENT_SECRET",
        "FILES_OAUTH_CLIENT_ID",
        "FILES_OAUTH_CLIENT_SECRET",
        "MESSAGES_OAUTH_CLIENT_ID",
        "MESSAGES_OAUTH_CLIENT_SECRET",
        "CLIENTS_OAUTH_CLIENT_ID",
        "CLIENTS_OAUTH_CLIENT_SECRET",
        "EMPLOYEES_OAUTH_CLIENT_ID",
        "EMPLOYEES_OAUTH_CLIENT_SECRET",
        "CONTROL_TOWER_OAUTH_CLIENT_ID",
        "CONTROL_TOWER_OAUTH_CLIENT_SECRET",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "LANDING_APP_URL",
        "COPILOT_APP_URL",
        "PROJECTS_APP_URL",
        "CALENDARS_APP_URL",
        "FILES_APP_URL",
        "MESSAGES_APP_URL",
        "CLIENTS_APP_URL",
        "EMPLOYEES_APP_URL",
        "CONTROL_TOWER_APP_URL",
        "OAUTH_TRUSTED_CLIENT_IDS",
        "OPENAI_API_KEY",
        "OPENAI_API_URL",
        "ASSISTANT_MODEL",
        "MCP_RESOURCE_URL",
        "CRON_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITLAB_CLIENT_ID",
        "GITLAB_CLIENT_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "FEEDBACK_EMAIL_TO",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_WORKSPACE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "REQUIRE_EMAIL_VERIFICATION",
        "TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "SIGNUP_INVITE_ONLY",
        "SIGNUP_BLOCKED_EMAIL_DOMAINS",
        "TRUSTED_IP_HEADERS",
        "CONTROL_TOWER_BETTER_AUTH_SECRET",
        "PLATFORM_APP_URL",
        "CONTROL_TOWER_URL",
        "PLATFORM_ALLOWED_IPS",
        "DEPLOY_ENV",
        "GIT_COMMIT_SHA",
        "SENTRY_DSN",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_PRICE_TEAM_MONTHLY",
        "STRIPE_PRICE_TEAM_YEARLY",
        "STRIPE_AUTOMATIC_TAX"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "^generate",
        "^build"
      ],
      "cache": false
    }
  }
}
